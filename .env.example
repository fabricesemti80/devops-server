# # Vault Secrets
VAULT_ROOT_TOKEN=root

# # Wiki.js Database
WIKI_DB_USER=wikijs
WIKI_DB_PASS=changeme_wiki
WIKI_DB_NAME=wikijs

# # Semaphore Database & Admin
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASS=changeme_semaphore
SEMAPHORE_DB_NAME=semaphore
SEMAPHORE_ADMIN_PASS=changeme_admin

# # Semaphore secret encryption
# # Encrypts Key Store entries and Variable Group secrets at rest.
# # REQUIRED - the stack will not start without it.
# #
# # Generate a value:
# #   task semaphore:genkey
# # or, before Task is installed:
# #   openssl rand -base64 32
# #
# # BACK THIS UP with the other credentials. /etc/semaphore/config.json is not on
# # a volume, so if this is unset Semaphore mints a new key on every container
# # recreate and everything already in the database becomes permanently
# # undecryptable. See docs/semaphore-access-key-encryption.md
# SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# # Hosts behind TLS inspection
# # The ca-trust tasks mount this host CA bundle into Semaphore and Wiki.js.
# # Override this only when the assembled bundle lives elsewhere on the host.
# CA_CERTIFICATE_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# # PostgreSQL 15 to 18 migration
# # Override these only if the original Compose project or volume names differ.
# POSTGRES_MIGRATION_BACKUP_DIR=./backups/postgres-15
# WIKI_PG15_VOLUME=devops-server_wikijs_db_data
# SEMAPHORE_PG15_VOLUME=devops-server_semaphore_db_data

# # Custom Semaphore runtime image
# SEMAPHORE_BASE_IMAGE=semaphoreui/semaphore:latest
# SEMAPHORE_IMAGE=devops-server/semaphore:local